# Copy this file to backend/.env — backend/config/settings.py loads
# backend/.env, not a .env at the repository root.
# Never commit backend/.env or real credentials.

# Django
# DEBUG defaults to off. Without DJANGO_DEBUG=True, DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-your-own-local-secret
# Comma-separated; defaults to localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Transactional email (Brevo SMTP). Leave the first three blank to print
# emails, such as verification links, to the Django console instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
# Only if SMTP TLS fails with CERTIFICATE_VERIFY_FAILED: path from `python -c "import certifi; print(certifi.where())"`
# SSL_CERT_FILE=

# OpenAI (AI incident analysis and feedback analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sunbird AI text-to-speech (multilingual voice menu)
SUNBIRD_API_KEY=

# Africa's Talking (SMS, USSD, voice)
SMS_ENABLED=false
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Shared secret for the USSD callback; set it and append ?token=<value> to the callback URL when public.
USSD_CALLBACK_TOKEN=

# Voice conference (disabled until callback authentication and live integration are complete)
# Voice's own AT app (e.g. live) when SMS/USSD stay on sandbox; blank = the credentials above.
AT_VOICE_USERNAME=
AT_VOICE_API_KEY=
AT_VOICE_NUMBER=
AT_VOICE_CALLBACK_URL=
REDIS_URL=
VOICE_CONFERENCE_ENABLED=false
VOICE_CONFERENCE_MAX_PARTICIPANTS=20

# Critical-incident calls to the organizer and event managers
VOICE_CRITICAL_CALLS_ENABLED=false

# MarzPay (wallet.wearemarz.com) payment collection
MARZPAY_BASE_URL=https://wallet.wearemarz.com/api/v1
MARZPAY_API_KEY=
MARZPAY_API_SECRET=
MARZPAY_WEBHOOK_SECRET=
MARZPAY_CALLBACK_URL=
MARZPAY_DEFAULT_COUNTRY=UG
